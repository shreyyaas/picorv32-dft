# Pinned versions for a reproducible flow.
# Every script sources this file. Change a value here, never inside a script.

# PicoRV32 RTL (YosysHQ/picorv32, master as of 2026-09-07)
PICORV32_REPO=https://github.com/YosysHQ/picorv32
PICORV32_COMMIT=ef203c2b0a3fb793280f5114941416c425c5b461

# OSS CAD Suite (Yosys, Icarus Verilog, Verilator, GTKWave).
# Empty = setup.sh installs the latest release and prints its tag;
# paste that tag here (e.g. 2026-11-03) so later runs reuse it.
OSS_CAD_TAG=2026-11-04

# SKY130 PDK build, managed by ciel. Empty = setup.sh picks the newest
# build and prints its open_pdks commit hash; paste it here to pin it.
SKY130_PDK_HASH=792ef67037d74c8c51811eab3ce23cf793491296

# Python packages (installed into .venv)
CIEL_VERSION=3.2.0
FAULT_VERSION=0.9.4

# Quaigh: open-source ATPG that Fault can call (installed with cargo)
QUAIGH_VERSION=0.0.6

# Standard-cell library and corner used for every number in this repo
STD_CELL_LIB=sky130_fd_sc_hd
LIB_CORNER=tt_025C_1v80
